# === Required ===

# Auth secret for session encryption
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Base URL of this app (used for redirects, CORS, etc.)
VITE_BASE_URL="http://localhost:3000"

# Vortex API base URL
VITE_API_BASE_URL="http://localhost:4000"

# Identity provider (HIDRA) base URL
VITE_AUTH_BASE_URL=""

# OAuth client credentials (from HIDRA)
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""

# === Optional (gracefully disabled when unset) ===

# Cache URL (Valkey/Redis, persists sessions across pod restarts)
CACHE_URL=""

# Billing portal (Aether)
VITE_BILLING_BASE_URL=""

# Authorization API (Warden)
VITE_AUTHZ_API_URL=""

# Internal API URL for server-to-server communication (e.g. Docker service name)
# Falls back to VITE_API_BASE_URL when unset
API_INTERNAL_URL=""

# === Optional OAuth providers ===

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
