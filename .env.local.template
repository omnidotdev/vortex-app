# === Required ===

# Auth secret for session encryption
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Cache URL (Valkey/Redis, persists sessions across pod restarts)
CACHE_URL=""

# === Optional (gracefully disabled when unset) ===

# Emails (Resend)
# https://resend.com/api-keys
RESEND_API_KEY=""

# Payment processing (Stripe)
# https://docs.stripe.com/keys
STRIPE_API_KEY=""

# Hatchet workflow engine
# Get token from http://localhost:8888 -> Settings -> API Tokens
HATCHET_CLIENT_TOKEN=""
HATCHET_CLIENT_TLS_STRATEGY=none

# Feature flags
VITE_FLAGS_CLIENT_KEY=

# OpenTelemetry (optional in dev, recommended in prod)
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_SERVICE_NAME="vortex-app"
